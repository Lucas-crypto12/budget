# Database — SQLite til lokal udvikling, skift til postgresql:// til produktion
DATABASE_URL="file:./dev.db"

# Server port (valgfri, default 3000)
PORT=3000

# Automatisk sync — cron-udtryk i Europe/Copenhagen tidzone (default: dagligt kl. 02:00)
SYNC_CRON="0 2 * * *"

# Sæt til "false" for at deaktivere automatisk sync
SYNC_ENABLED=true
